<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pastelPink"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra Superior -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Registrar Gasto"
                android:textColor="@color/textDarkPink"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Tarjeta de Monto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta_monto"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MONTO"
                android:textColor="@color/textDarkPink"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-$"
                    android:textColor="@color/cherryPink"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="0|0"
                    android:textColorHint="#E6B8C3"
                    android:textColor="@color/cherryPink"
                    android:inputType="numberDecimal"
                    android:background="@null"
                    android:textSize="40sp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registra el valor del egreso"
                android:textColor="#B08895"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Campos del Formulario -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fecha" android:textColor="@color/textDarkPink" android:textStyle="bold"/>
        <EditText android:id="@+id/etDate" android:layout_width="match_parent" android:layout_height="50dp" android:background="@color/white" android:hint="08/10/2026" android:padding="12dp" android:layout_marginBottom="16dp" android:layout_marginTop="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Categoría" android:textColor="@color/textDarkPink" android:textStyle="bold"/>
        <EditText android:id="@+id/etCategory" android:layout_width="match_parent" android:layout_height="50dp" android:background="@color/white" android:hint="Selecciona una categoría" android:padding="12dp" android:layout_marginBottom="16dp" android:layout_marginTop="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Método" android:textColor="@color/textDarkPink" android:textStyle="bold"/>
        <EditText android:id="@+id/etMethod" android:layout_width="match_parent" android:layout_height="50dp" android:background="@color/white" android:hint="Selecciona un método" android:padding="12dp" android:layout_marginBottom="16dp" android:layout_marginTop="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Descripción" android:textColor="@color/textDarkPink" android:textStyle="bold"/>
        <EditText android:id="@+id/etDescription" android:layout_width="match_parent" android:layout_height="100dp" android:background="@color/white" android:hint="Agrega una nota sobre este gasto" android:gravity="top" android:padding="12dp" android:layout_marginTop="8dp" android:layout_marginBottom="32dp"/>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Limpiar"
                android:textColor="@color/cherryPink"
                android:backgroundTint="@color/white"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Guardar"
                android:textColor="@color/white"
                android:backgroundTint="@color/cherryPink"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>